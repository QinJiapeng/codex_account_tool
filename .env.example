# 复制为 .env 后按本机环境填写；不要把 .env 提交到 GitHub。
APP_HOST=127.0.0.1
APP_PORT=10717
DATA_DIR=./data

# 重新授权并发数；每个任务只使用自己的邮箱 OTP。
# 项目默认配置：代理池、CPA 自动上传和定时验活开启；Sub2API 自动上传关闭。
REAUTH_WORKERS=20
USE_PROXY_DEFAULT=true
AUTO_UPLOAD_CPA=true
AUTO_UPLOAD_SUB2API=false
# 上传时是否忽略本地“已上传”记录并强制重传；默认关闭。
FORCE_UPLOAD=false
# 定时验活默认每 5 分钟执行；仅对明确失效的已授权账号重新授权。
SCHEDULED_LIVENESS_ENABLED=true
SCHEDULED_LIVENESS_INTERVAL_MINUTES=5
PROXY_LEASE_SECONDS=1200
PROXY_COOLDOWN_SECONDS=60
# 可选：启动时导入代理，多个地址用换行分隔。支持 http(s)/socks4/5。
PROXY_LIST=
PROXY_LIST_FILE=

OUTLOOK_IMAP_HOST=outlook.office365.com
OUTLOOK_IMAP_PORT=993
OTP_POLL_SECONDS=5
OTP_TIMEOUT_SECONDS=180

CODEX_USAGE_URL=https://chatgpt.com/backend-api/wham/usage
CODEX_USAGE_VERSION=0.144.1
CODEX_USAGE_TIMEOUT_MS=15000

# 可选：授权结果上传；留空表示只使用本地导出。
CLI_PROXY_API_URL=
CLI_PROXY_MANAGEMENT_KEY=
CLI_PROXY_API_TIMEOUT_SECONDS=30
SUB2API_API_URL=
SUB2API_ADMIN_API_KEY=
SUB2API_API_TIMEOUT_SECONDS=30
